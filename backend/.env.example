# Copie para .env e ajuste. O .env real NUNCA entra no git.

# O ambiente NÃO se escolhe aqui: manage.py usa dev e wsgi.py usa prod.
# No VPS quem manda é o env_file do compose, que exporta de verdade.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# (não use get_random_secret_key: 1 em 50 começa com "$", e o leitor de .env
#  trata isso como referência a outra variável — a API não sobe)
SECRET_KEY=troque-esta-chave-em-producao

DATABASE_URL=postgres://enseadas@localhost:5432/enseadas

# Site que consome a API (origem exata, sem barra no fim).
# EM PRODUÇÃO estes dois são obrigatórios e não podem ser localhost —
# prod.py recusa subir, senão os e-mails sairiam com link para localhost.
SITE_URL=http://localhost:4321
ORIGENS_SITE=http://localhost:4321,http://127.0.0.1:4321

# Só em produção (prod.py recusa subir sem a chave do Resend)
API_HOST=api.enseadas.com.br
EMAIL_HOST_PASSWORD=coloque-a-chave-do-resend-aqui
DEFAULT_FROM_EMAIL=EnseadaS <revista@enseadas.com.br>
ADMIN_EMAIL=douglas@danzi.com.br
