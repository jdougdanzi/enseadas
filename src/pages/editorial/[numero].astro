---
/**
 * Editorial da edição (Manual da Marca — Template 3 das Páginas Internas):
 * opinião à esquerda, expediente e cartas na coluna lateral.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderCompacto from '../../components/HeaderCompacto.astro';
import BadgeRascunho from '../../components/BadgeRascunho.astro';
import RetratoEditor from '../../components/RetratoEditor.astro';
import { EXPEDIENTE, SITE } from '../../config';
import {
  getEdicoes,
  getEditorialDaEdicao,
  ehRascunho,
  type Materia,
  type Edicao,
} from '../../lib/conteudo';
import { numeroEdicao, mesAno } from '../../lib/datas';
import { artigo, trilha } from '../../lib/seo';
import { abs } from '../../lib/url';

export async function getStaticPaths() {
  const edicoes = await getEdicoes();
  const rotas = [];

  for (const edicao of edicoes) {
    const editorial = await getEditorialDaEdicao(edicao.data.numero);
    if (!editorial) continue;
    rotas.push({
      params: { numero: numeroEdicao(edicao.data.numero) },
      props: { editorial, edicao },
    });
  }
  return rotas;
}

interface Props {
  editorial: Materia;
  edicao: Edicao;
}

const { editorial, edicao } = Astro.props;
const { Content } = await render(editorial);

const todasCartas = await getCollection('cartas');
const cartas = todasCartas
  .filter((c) => c.data.edicao <= edicao.data.numero)
  .sort((a, b) => b.data.edicao - a.data.edicao)
  .slice(0, 2);

const caminho = `/editorial/${numeroEdicao(edicao.data.numero)}`;

const jsonLd = [
  artigo({
    titulo: editorial.data.titulo,
    descricao: editorial.data.linhaFina,
    caminho,
    data: editorial.data.data,
    autor: 'Conselho Editorial',
    tipo: 'OpinionNewsArticle',
    imagem: abs('/og-padrao.png'),
  }),
  trilha([
    { nome: 'Capa', caminho: '/' },
    { nome: `Editorial Nº ${numeroEdicao(edicao.data.numero)}`, caminho },
  ]),
];
---

<BaseLayout
  titulo={editorial.data.titulo}
  descricao={editorial.data.linhaFina}
  caminho={caminho}
  tipoOg="article"
  publicadoEm={editorial.data.data}
  autor="Conselho Editorial"
  secao="Opinião"
  jsonLd={jsonLd}
  semIndexacao={ehRascunho(editorial)}
>
  <div class="container">
    <HeaderCompacto data={edicao.data.dataFechamento} />

    <main id="conteudo">
      <div class="grade">
        <article class="opiniao" data-pagefind-body data-pagefind-meta="kicker:Opinião · Editorial">
          <p class="kicker linha-kicker" data-pagefind-ignore>
            <span>Opinião · Editorial</span>
            <span class="risco" aria-hidden="true"></span>
            {ehRascunho(editorial) && <BadgeRascunho />}
          </p>

          <h1 class="titulo">{editorial.data.titulo}</h1>
          <p class="deck">{editorial.data.linhaFina}</p>

          <div class="corpo texto-editorial">
            <Content />
          </div>

          <div class="assinatura">
            <RetratoEditor tamanho={96} decorativo={false} />
            <div>
              <p class="conselho">{SITE.autorPadrao}</p>
              <p class="rotulo">Direção editorial</p>
              <p class="rotulo local" data-pagefind-meta="data">
                {SITE.cidadeSede}, {mesAno(edicao.data.dataFechamento)} · Edição Nº {
                  numeroEdicao(edicao.data.numero)
                }
              </p>
            </div>
          </div>
        </article>

        <div class="fio-vertical" aria-hidden="true"></div>

        <aside class="lateral">
          <section class="bloco-expediente">
            <div class="fio-triplo"></div>
            <div class="fio-tinta conteudo-bloco">
              <h2 class="titulo-bloco">Expediente</h2>
              <dl class="expediente">
                {
                  EXPEDIENTE.map((item) => (
                    <div class="item-expediente">
                      <dt>{item.funcao}</dt>
                      <dd>{item.nome}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </section>

          {
            cartas.length > 0 && (
              <section class="bloco-cartas">
                <h2 class="titulo-bloco">Cartas da comunidade</h2>
                {cartas.map((carta) => (
                  <blockquote class="carta">
                    <p class="carta-texto">{carta.data.texto}</p>
                    <footer class="rotulo">{carta.data.assinatura}</footer>
                  </blockquote>
                ))}
              </section>
            )
          }

          <div class="caixa-apoio escreva">
            <p class="rotulo-caixa">Escreva para nós</p>
            <p class="texto-caixa">
              Sua carta pode sair na próxima edição:
              <a href={`mailto:${SITE.emailCartas}`}>{SITE.emailCartas}</a>
            </p>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .grade {
    display: grid;
    grid-template-columns: 1.5fr 1px 1fr;
    gap: 32px;
    padding-top: 30px;
  }

  .opiniao {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .linha-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    letter-spacing: 0.3em;
  }

  .risco {
    flex: 1;
    height: 1px;
    background: var(--fio);
  }

  .titulo {
    font-family: var(--serif-titulo);
    font-weight: 900;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.25rem);
    line-height: 1.15;
  }

  /* No editorial o texto ocupa a coluna inteira da grade, não os 680px do corpo padrão. */
  .texto-editorial {
    max-width: none;
    margin-inline: 0;
    font-size: 1.0625rem;
  }

  .assinatura {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding-top: 10px;
    border-top: var(--fio-fino) solid var(--fio);
  }

  .conselho {
    font-family: var(--serif-titulo);
    font-style: italic;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--azul);
  }

  .local {
    margin-top: 4px;
  }

  .lateral {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .conteudo-bloco {
    padding: 14px 0;
  }

  .titulo-bloco {
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--t-kicker);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--tinta);
    margin-bottom: 12px;
  }

  .expediente {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .item-expediente dt {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.5625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--azul);
  }

  .item-expediente dd {
    margin: 1px 0 0;
    font-family: var(--serif-texto);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .bloco-cartas {
    border-top: var(--fio-fino) solid var(--fio);
    padding: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .carta {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
  }

  .carta-texto {
    font-family: var(--serif-texto);
    font-style: italic;
    font-size: 0.90625rem;
    line-height: 1.5;
  }

  .escreva {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .rotulo-caixa {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.59375rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--azul);
  }

  .texto-caixa {
    font-family: var(--sans);
    font-size: 0.78125rem;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .grade {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .fio-vertical {
      display: none;
    }

    .lateral {
      border-top: var(--fio-fino) solid var(--tinta);
      padding-top: 20px;
    }

    .escreva {
      margin-top: 16px;
    }
  }
</style>
