---
/**
 * Chips de assunto ao fim da matéria, em azul-papel.
 */
import { slugAssunto } from '../lib/assuntos';
import { rotas } from '../lib/url';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" aria-label="Assuntos">
      {tags.map((tag) => (
        <li>
          <a class="chip" href={rotas.assunto(slugAssunto(tag))}>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
