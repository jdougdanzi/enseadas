---
/**
 * Corpo da capa (Manual da Marca, seção 05):
 * lead 2/3 + fio vertical + coluna lateral 1/3, e a linha inferior de três matérias.
 * Usado tanto na home quanto no arquivo de edições.
 */
import ChamadaLead from './ChamadaLead.astro';
import ChamadaLateral from './ChamadaLateral.astro';
import CartaoMateria from './CartaoMateria.astro';
import CaixaDestaque from './CaixaDestaque.astro';
import RetratoEditor from './RetratoEditor.astro';
import { SITE } from '../config';
import { rotas } from '../lib/url';
import { numeroEdicao } from '../lib/datas';
import type { CapaMontada, Materia } from '../lib/conteudo';

interface Props {
  capa: CapaMontada;
  /** Editorial da edição, quando houver — ganha chamada própria com retrato. */
  editorial?: Materia;
}

const { capa, editorial } = Astro.props;
const tituloEditorial = editorial?.data.titulo ?? '';
const { edicao, manchete, laterais, linhaInferior } = capa;
const destaque = edicao.data.destaqueLateral;
const caminhoEdicao = rotas.edicao(edicao.data.numero);

// Com poucas chamadas, a coluna lateral fica curta ao lado do lead: as
// linhas-finas ocupam o espaço com texto útil em vez de vazio.
const lateralComDeck = laterais.length <= 3;
---

<div class="capa">
  <div class="principal">
    <div class="coluna-lead">
      {
        manchete ? (
          <ChamadaLead materia={manchete} nivel="h2" proporcao="16 / 9" prioridade />
        ) : (
          <p class="vazio">
            A manchete desta edição ainda não foi definida.
          </p>
        )
      }
    </div>

    <div class="fio-vertical" aria-hidden="true"></div>

    <div class="coluna-lateral">
      {
        laterais.map((materia, i) => (
          <div class:list={['item-lateral', { primeiro: i === 0 }]}>
            <ChamadaLateral materia={materia} comDeck={lateralComDeck} />
          </div>
        ))
      }

      {
        editorial && (
          <div class="item-lateral bloco-editorial">
            <RetratoEditor tamanho={78} />
            <div class="texto-editorial">
              <p class="kicker kicker-editorial">Opinião · Editorial</p>
              <p class="link-editorial">
                <a href={rotas.editorial(edicao.data.numero)}>{tituloEditorial}</a>
              </p>
              <p class="assina-editorial">Por {SITE.autorPadrao}</p>
            </div>
          </div>
        )
      }

      <div class="rodape-lateral">
        <CaixaDestaque
          titulo={destaque?.titulo}
          texto={destaque?.texto}
          caminhoCompartilhar={caminhoEdicao}
          tituloCompartilhar={`EnseadaS — Edição Nº ${numeroEdicao(edicao.data.numero)}`}
        />
      </div>
    </div>
  </div>

  {
    linhaInferior.length > 0 && (
      <div class="fio-tinta linha-inferior">
        {linhaInferior.map((materia) => (
          <CartaoMateria materia={materia} />
        ))}
      </div>
    )
  }
</div>

<style>
  .principal {
    display: grid;
    grid-template-columns: 1.6fr 1px 1fr;
    gap: 26px;
    border-top: var(--fio-fino) solid var(--fio);
    padding: 26px 0;
  }

  .coluna-lateral {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .item-lateral {
    padding: 16px 0;
    border-bottom: var(--fio-fino) solid var(--fio);
  }

  .item-lateral.primeiro {
    padding-top: 0;
  }

  /* O editorial ganha o retrato do editor ao lado — é o convite ao clique. */
  .bloco-editorial {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .texto-editorial {
    min-width: 0;
  }

  .kicker-editorial {
    font-size: 0.59375rem;
    letter-spacing: 0.26em;
    margin-bottom: 6px;
  }

  .assina-editorial {
    margin-top: 6px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-rotulo);
    color: var(--cinza-rotulo);
  }

  .link-editorial {
    font-family: var(--serif-titulo);
    font-style: italic;
    font-weight: 700;
    font-size: var(--t-titulo-3);
    line-height: 1.25;
  }

  .link-editorial a {
    color: var(--tinta);
  }

  .link-editorial a:hover,
  .link-editorial a:focus-visible {
    color: var(--azul);
    text-decoration: none;
  }

  .rodape-lateral {
    margin-top: auto;
    padding-top: 16px;
  }

  /* auto-fit para a linha fechar bonito com uma, duas ou três matérias */
  .linha-inferior {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 26px;
    padding: 22px 0 6px;
  }

  .vazio {
    font-family: var(--serif-texto);
    font-style: italic;
    color: var(--cinza-rotulo);
  }

  @media (max-width: 860px) {
    .principal {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: 0;
    }

    .fio-vertical {
      display: none;
    }

    .coluna-lateral {
      border-top: var(--fio-fino) solid var(--tinta);
      margin-top: 26px;
      padding-top: 6px;
    }

    .rodape-lateral {
      padding-bottom: 22px;
    }

    .linha-inferior {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }

  @media (min-width: 861px) and (max-width: 1000px) {
    .linha-inferior {
      gap: 20px;
    }
  }
</style>
