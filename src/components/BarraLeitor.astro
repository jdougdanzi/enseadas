---
/**
 * Barra de ações ao pé da matéria, no espírito das barras de engajamento de
 * jornal: um convite grande e uma fileira de ações discretas.
 *
 * O site é estático, sem servidor — então aqui não há contador de comentários
 * nem curtida: seria número inventado. O lugar do comentário é a carta, que
 * pode sair na página de editorial da edição seguinte.
 *
 * Sem JavaScript, os links (carta e WhatsApp) continuam funcionando; os botões
 * que dependem do navegador só aparecem quando o script roda.
 */
import { SITE } from '../config';
import { abs, linkWhatsApp, rotas } from '../lib/url';

interface Props {
  titulo: string;
  caminho: string;
}

const { titulo, caminho } = Astro.props;

const url = abs(caminho);
const assuntoCarta = `Sobre a matéria: ${titulo}`;
const linkCarta = `mailto:${SITE.emailCartas}?subject=${encodeURIComponent(assuntoCarta)}`;
---

<!-- data-pagefind-ignore: texto de interface repetido não entra no índice da busca. -->
<section
  class="barra"
  aria-labelledby="barra-titulo"
  data-barra-leitor
  data-pagefind-ignore
  data-url={url}
  data-titulo={titulo}
>
  <h2 class="apenas-leitores" id="barra-titulo">O que fazer com esta matéria</h2>

  <a class="convite" href={linkCarta}>Mande sua carta sobre esta matéria</a>

  <p class="explicacao">
    Não temos caixa de comentários: as cartas selecionadas saem na página de editorial
    da próxima edição, com o primeiro nome e a cidade de quem escreveu.
    <a href={rotas.contato()}>Veja os outros caminhos para falar com a redação</a>.
  </p>

  <div class="acoes">
    <a class="pilula" href={linkWhatsApp(titulo, caminho)} rel="noopener" target="_blank">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="icone">
        <path
          d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.6-4.3A8.5 8.5 0 1 1 20.5 11.6Z"
        ></path>
        <path d="M8.8 9.2c.4 2.6 2.4 4.6 5 5l1-1.4 1.9.8-.4 1.7c-2.9.5-6.9-3.5-6.4-6.4l1.7-.4.8 1.9-1.6-1.2Z"
        ></path>
      </svg>
      Enviar no WhatsApp
    </a>

    <button class="redondo so-com-js" type="button" data-acao="compartilhar" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="icone">
        <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"></path>
        <path d="M12 15V3"></path>
        <path d="M8 7l4-4 4 4"></path>
      </svg>
      <span class="apenas-leitores">Compartilhar esta matéria</span>
    </button>

    <button class="redondo so-com-js" type="button" data-acao="copiar" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="icone">
        <path d="M10.5 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1 1"></path>
        <path d="M13.5 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1-1"></path>
      </svg>
      <span class="apenas-leitores">Copiar o link</span>
    </button>

    <button
      class="redondo so-com-js"
      type="button"
      data-acao="salvar"
      aria-pressed="false"
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="icone marcador">
        <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-4-6.5 4v-16a1 1 0 0 1 1-1Z"></path>
      </svg>
      <span class="rotulo-salvar">Salvar</span>
    </button>
  </div>

  <p class="aviso" role="status" aria-live="polite"></p>
</section>

<style>
  .barra {
    max-width: var(--max-corpo);
    margin: 34px auto 0;
    border-top: var(--fio-grosso) solid var(--tinta);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .convite {
    display: block;
    background: var(--azul);
    color: var(--papel);
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    padding: 16px 18px;
  }

  .convite:hover,
  .convite:focus-visible {
    background: var(--azul-escuro);
    color: var(--papel);
    text-decoration: none;
  }

  .explicacao {
    font-family: var(--sans);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--cinza-rotulo);
  }

  .explicacao a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .acoes {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
  }

  .pilula,
  .redondo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: var(--fio-fino) solid var(--fio);
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.75rem;
    cursor: pointer;
    padding: 10px 16px;
  }

  .redondo {
    width: 42px;
    height: 42px;
    padding: 0;
  }

  .pilula:hover,
  .redondo:hover,
  .pilula:focus-visible,
  .redondo:focus-visible {
    border-color: var(--azul);
    color: var(--azul);
    text-decoration: none;
  }

  .icone {
    width: 19px;
    height: 19px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Marcador cheio quando a matéria está salva. */
  .redondo[aria-pressed='true'] {
    border-color: var(--azul);
    color: var(--azul);
  }

  .redondo[aria-pressed='true'] .marcador {
    fill: var(--azul);
  }

  .rotulo-salvar {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .aviso:empty {
    display: none;
  }

  .aviso {
    font-family: var(--sans);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--azul);
  }

  @media (max-width: 480px) {
    .convite {
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      padding: 14px 12px;
    }
  }
</style>

<script>
  const CHAVE = 'enseadas:salvos';

  type Salvo = { url: string; titulo: string; salvoEm: string };

  function lerSalvos(): Salvo[] {
    try {
      const bruto = localStorage.getItem(CHAVE);
      const dados = bruto ? JSON.parse(bruto) : [];
      return Array.isArray(dados) ? dados : [];
    } catch {
      return [];
    }
  }

  function gravarSalvos(lista: Salvo[]) {
    try {
      localStorage.setItem(CHAVE, JSON.stringify(lista));
    } catch {
      /* modo privado ou armazenamento cheio: a ação simplesmente não persiste */
    }
  }

  const barra = document.querySelector<HTMLElement>('[data-barra-leitor]');

  if (barra) {
    const url = barra.dataset.url ?? location.href;
    const titulo = barra.dataset.titulo ?? document.title;
    const aviso = barra.querySelector<HTMLElement>('.aviso');
    const botaoCompartilhar = barra.querySelector<HTMLButtonElement>('[data-acao="compartilhar"]');
    const botaoCopiar = barra.querySelector<HTMLButtonElement>('[data-acao="copiar"]');
    const botaoSalvar = barra.querySelector<HTMLButtonElement>('[data-acao="salvar"]');

    const dizer = (texto: string) => {
      if (!aviso) return;
      aviso.textContent = texto;
      window.setTimeout(() => {
        if (aviso.textContent === texto) aviso.textContent = '';
      }, 3000);
    };

    // Compartilhamento nativo só existe em parte dos navegadores; sem ele, o
    // botão não aparece e o leitor usa o WhatsApp ou o copiar link.
    if (navigator.share && botaoCompartilhar) {
      botaoCompartilhar.hidden = false;
      botaoCompartilhar.addEventListener('click', async () => {
        try {
          await navigator.share({ title: titulo, url });
        } catch {
          /* o leitor cancelou */
        }
      });
    }

    if (navigator.clipboard && botaoCopiar) {
      botaoCopiar.hidden = false;
      botaoCopiar.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          dizer('Link copiado.');
        } catch {
          dizer('Não foi possível copiar. Copie da barra de endereço.');
        }
      });
    }

    if (botaoSalvar) {
      botaoSalvar.hidden = false;

      const pintar = (salvo: boolean) => {
        botaoSalvar.setAttribute('aria-pressed', String(salvo));
        const rotulo = botaoSalvar.querySelector('.rotulo-salvar');
        if (rotulo) rotulo.textContent = salvo ? 'Remover dos salvos' : 'Salvar para ler depois';
      };

      pintar(lerSalvos().some((s) => s.url === url));

      botaoSalvar.addEventListener('click', () => {
        const lista = lerSalvos();
        const jaSalvo = lista.some((s) => s.url === url);

        if (jaSalvo) {
          gravarSalvos(lista.filter((s) => s.url !== url));
          pintar(false);
          dizer('Removido dos salvos.');
        } else {
          lista.unshift({ url, titulo, salvoEm: new Date().toISOString() });
          gravarSalvos(lista.slice(0, 100));
          pintar(true);
          dizer('Salvo para ler depois, neste navegador.');
        }
      });
    }
  }
</script>
