---
/**
 * Assinatura da marca (Manual da Marca, seção 01) — não redesenhar.
 * Bloco E quadrado + wordmark "Enseada" com o S final 22% maior + linha de apoio.
 */
import { SITE } from '../config';
import { rotas } from '../lib/url';

interface Props {
  /**
   * Lado do bloco E: um número (px) ou qualquer medida CSS — inclusive
   * `clamp()`, para a assinatura crescer no desktop sem estourar no celular.
   * O resto da assinatura escala a partir dele.
   */
  tamanho?: number | string;
  /** Exibe a linha "DIÁRIO DE BOAS NOTÍCIAS · ES" sob o wordmark. */
  comTagline?: boolean;
  /** No masthead da capa a linha vem por extenso: "· ESPÍRITO SANTO". */
  taglineCompleta?: boolean;
  /** Versão negativa, para uso sobre fundo azul. */
  negativo?: boolean;
  /** Envolve a assinatura num link para a capa. */
  comLink?: boolean;
  /** Renderiza o nome como <h1> (usar apenas no masthead da capa). */
  comoTitulo?: boolean;
}

const {
  tamanho = 46,
  comTagline = false,
  taglineCompleta = false,
  negativo = false,
  comLink = true,
  comoTitulo = false,
} = Astro.props;

const textoTagline = taglineCompleta ? SITE.tagline : SITE.taglineCurta;

const corMarca = negativo ? 'var(--papel)' : 'var(--azul)';
const corBlocoFundo = negativo ? 'var(--papel)' : 'var(--azul)';
const corBlocoLetra = negativo ? 'var(--azul)' : 'var(--papel)';

const lado = typeof tamanho === 'number' ? `${tamanho}px` : tamanho;

const estilo = [
  `--logo-lado:${lado}`,
  `--logo-cor:${corMarca}`,
  `--logo-bloco-fundo:${corBlocoFundo}`,
  `--logo-bloco-letra:${corBlocoLetra}`,
].join(';');

const Nome = comoTitulo ? 'h1' : 'span';

// Sem link, a assinatura vira um <span>: um <a> "desligado" por CSS continuaria
// focável pelo teclado — um alvo morto para quem navega sem mouse.
const Envelope = comLink ? 'a' : 'span';
const atributos = comLink
  ? { href: rotas.capa(), 'aria-label': `${SITE.nome} — ${SITE.tagline}` }
  : {};
---

<div class="logo" style={estilo}>
  <Envelope class="logo-link" {...atributos}>
    <span class="bloco" aria-hidden="true">E</span>
    <span class="assinatura">
      <Nome class="wordmark">Enseada<span class="s-final">S</span></Nome>
      {
        comTagline && (
          <span class="tagline">
            <span class="tagline-fio" aria-hidden="true" />
            <span class="tagline-texto">{textoTagline}</span>
            {
              taglineCompleta && (
                <span class="tagline-texto curta">{SITE.taglineCurta}</span>
              )
            }
          </span>
        )
      }
    </span>
  </Envelope>
</div>

<style>
  .logo {
    display: inline-block;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-lado) * 0.28);
    color: var(--logo-cor);
    text-decoration: none;
  }

  .logo-link:hover,
  .logo-link:focus-visible {
    color: var(--logo-cor);
    text-decoration: none;
    opacity: 0.82;
  }


  .bloco {
    flex: none;
    width: var(--logo-lado);
    height: var(--logo-lado);
    background: var(--logo-bloco-fundo);
    color: var(--logo-bloco-letra);
    font-family: var(--serif-titulo);
    font-weight: 900;
    font-size: calc(var(--logo-lado) * 0.7);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: calc(var(--logo-lado) * 0.07);
  }

  .assinatura {
    display: flex;
    flex-direction: column;
    gap: calc(var(--logo-lado) * 0.07);
  }

  .wordmark {
    margin: 0;
    font-family: var(--serif-titulo);
    font-weight: 700;
    font-size: calc(var(--logo-lado) * 0.57);
    line-height: 1;
    color: var(--logo-cor);
    white-space: nowrap;
  }

  /* O plural das enseadas capixabas: S final 22% maior. */
  .s-final {
    font-size: 1.22em;
  }

  .tagline {
    display: flex;
    align-items: center;
    gap: calc(var(--logo-lado) * 0.17);
  }

  .tagline-fio {
    display: block;
    width: calc(var(--logo-lado) * 0.45);
    height: 1px;
    background: var(--logo-cor);
    flex: none;
  }

  .tagline-texto {
    font-family: var(--sans);
    font-weight: 600;
    /* A linha de apoio cresce com a assinatura, mas para de crescer antes de
       competir com o nome — ela é subordinada ao wordmark. */
    font-size: clamp(7.5px, calc(var(--logo-lado) * 0.175), 12px);
    letter-spacing: 0.3em;
    color: var(--logo-cor);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Em telas estreitas a linha por extenso não cabe: entra a versão curta. */
  .tagline-texto.curta {
    display: none;
  }

  @media (max-width: 620px) {
    .tagline-texto:not(.curta) {
      display: none;
    }

    .tagline-texto.curta {
      display: inline;
    }
  }
</style>
