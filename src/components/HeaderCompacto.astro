---
/**
 * Cabeçalho das páginas internas (caderno, matéria, editorial):
 * assinatura reduzida à esquerda, cadernos ao centro, data à direita.
 */
import Logo from './Logo.astro';
import NavCadernos from './NavCadernos.astro';
import { dataCurta } from '../lib/datas';

interface Props {
  data?: string;
  ativo?: string;
}

const { data, ativo = '' } = Astro.props;
---

<!-- Sentinela: quando ela sai de vista, o cabeçalho está grudado no topo. -->
<div class="sentinela" aria-hidden="true"></div>

<header class="cabecalho" data-cabecalho>
  <div class="marca">
    <!-- A medida vem de uma variável para o CSS poder encolhê-la quando o
         cabeçalho gruda: estilo inline sempre venceria uma regra de folha. -->
    <Logo tamanho="var(--logo-cabecalho, clamp(34px, 3.2vw, 42px))" />
  </div>

  <div class="cadernos">
    <NavCadernos ativo={ativo} compacta />
  </div>

  {data && <div class="data">{dataCurta(data)}</div>}
</header>

<style>
  /* 1px, e não zero: o IntersectionObserver ignora elemento sem área. */
  .sentinela {
    height: 1px;
    margin-bottom: -1px;
  }

  .cabecalho {
    --logo-cabecalho: clamp(34px, 3.2vw, 42px);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--papel);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 0 12px;
    border-bottom: var(--fio-fino) solid var(--tinta);
    transition:
      padding 0.2s ease,
      --logo-cabecalho 0.2s ease;
  }

  /* Grudado, o cabeçalho encolhe para roubar o mínimo de tela do texto. */
  .cabecalho[data-fixa] {
    --logo-cabecalho: 26px;
    padding: 8px 0 7px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cabecalho {
      transition: none;
    }
  }

  .marca {
    flex: none;
  }

  .cadernos {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .data {
    flex: none;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    color: var(--cinza-rotulo);
    text-transform: uppercase;
  }

  /* Tela baixa (celular deitado): grudado, o cabeçalho de duas linhas comia
     23% da altura. Ali ele vira uma linha só — a navegação volta ao rolar
     para cima, que é o gesto natural de quem quer sair da matéria. */
  @media (max-height: 520px) {
    .cabecalho[data-fixa] .cadernos {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .cabecalho {
      flex-wrap: wrap;
      gap: 10px;
    }

    .cadernos {
      order: 3;
      flex-basis: 100%;
      justify-content: flex-start;
      border-top: var(--fio-fino) solid var(--fio);
      padding-top: 10px;
    }
  }
</style>

<script>
  // Sem JS o cabeçalho continua grudando: isto só liga o encolhimento.
  const sentinela = document.querySelector('.sentinela');
  const cabecalho = document.querySelector('[data-cabecalho]');

  if (sentinela && cabecalho && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entrada]) => {
        cabecalho.toggleAttribute('data-fixa', !entrada.isIntersecting);
      },
      { threshold: 0 },
    ).observe(sentinela);
  }
</script>
