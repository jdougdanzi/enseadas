---
/**
 * Abertura da capa de caderno: "Nº3 SABORES" + tagline em itálico, sobre fio triplo.
 */
import type { Caderno } from '../data/cadernos';

interface Props {
  caderno: Caderno;
}

const { caderno } = Astro.props;
---

<div class="abertura">
  <div class="linha">
    <span class="numero" aria-hidden="true">Nº{caderno.numero}</span>
    <h1 class="nome">{caderno.nome}</h1>
    <span class="tagline">{caderno.tagline}</span>
  </div>
  <div class="fio-triplo"></div>
</div>

<style>
  .abertura {
    margin-bottom: 2px;
  }

  .linha {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding: 26px 0 14px;
  }

  .numero {
    font-family: var(--serif-titulo);
    font-weight: 900;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.625rem);
    line-height: 1;
    color: var(--azul);
  }

  .nome {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(1.375rem, 0.95rem + 1.9vw, 2.125rem);
    line-height: 1;
    letter-spacing: 0.22em;
    color: var(--tinta);
  }

  .tagline {
    margin-left: auto;
    font-family: var(--serif-texto);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--cinza-texto);
  }

  @media (max-width: 720px) {
    .tagline {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
